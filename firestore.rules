rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // GLOBAL PRIMITIVES & HELPERS
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mcshekhar077@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isDoctorOrStaff() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/doctors/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
    }

    // ============================================
    // VALIDATION BLUEPRINTS
    // ============================================

    function isValidEmergencySosAlert(data) {
      return data.keys().hasAll([
        'ticketNumber',
        'patientName',
        'phone',
        'status',
        'priority',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ticketNumber is string && data.ticketNumber.size() > 0 && data.ticketNumber.size() <= 64 &&
      data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 128 &&
      data.phone is string && data.phone.size() > 0 && data.phone.size() <= 32 &&
      data.status in ['active', 'acknowledged', 'dispatched', 'resolved', 'cancelled'] &&
      data.priority in ['CRITICAL_RED', 'HIGH_ORANGE', 'MEDIUM_YELLOW', 'LOW_GREEN'] &&
      data.createdAt is string && data.createdAt.size() <= 64 &&
      data.updatedAt is string && data.updatedAt.size() <= 64 &&
      (!('patientId' in data) || (data.patientId is string && data.patientId.size() <= 128)) &&
      (!('triggerSource' in data) || (data.triggerSource is string && data.triggerSource.size() <= 256)) &&
      (!('cancellationReason' in data) || (data.cancellationReason is string && data.cancellationReason.size() <= 256)) &&
      (!('assignedTeam' in data) || (data.assignedTeam is string && data.assignedTeam.size() <= 128)) &&
      (!('holdDurationMs' in data) || data.holdDurationMs is number) &&
      (!('responseTime' in data) || data.responseTime is number) &&
      (!('resolutionTime' in data) || data.resolutionTime is number) &&
      (!('location' in data) || data.location is map) &&
      (!('vitals' in data) || data.vitals is map) &&
      (!('notes' in data) || data.notes is list) &&
      (!('emergencyContacts' in data) || data.emergencyContacts is list) &&
      (!('assignedDoctor' in data) || data.assignedDoctor is map);
    }

    // ============================================
    // DEFAULT CATCH-ALL
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================
    // EMERGENCY SOS ALERTS
    // ============================================
    match /emergencySosAlerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() &&
        isValidId(alertId) &&
        isValidEmergencySosAlert(incoming());
        
      allow update: if isSignedIn() &&
        isValidId(alertId) &&
        isValidEmergencySosAlert(incoming()) &&
        incoming().ticketNumber == existing().ticketNumber &&
        incoming().createdAt == existing().createdAt;
        
      allow delete: if isAdmin();
    }

    // ============================================
    // PATIENTS & PROFILES
    // ============================================
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(patientId);
      allow update: if isSignedIn() && (request.auth.uid == patientId || isDoctorOrStaff());
      allow delete: if isAdmin();
    }

    // ============================================
    // DOCTORS & STAFF
    // ============================================
    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================
    // APPOINTMENTS
    // ============================================
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(appointmentId);
      allow update: if isSignedIn() && isValidId(appointmentId);
      allow delete: if isAdmin();
    }

    // ============================================
    // VITALS & CLINICAL RECORDS
    // ============================================
    match /vitals/{vitalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(vitalId);
    }

    // ============================================
    // HEALTH CHECK & MONITORING
    // ============================================
    match /_connection_test/{testId} {
      allow read, write: if true;
    }
  }
}
